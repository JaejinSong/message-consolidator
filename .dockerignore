# Why: Heavy directories and intermediate artifacts — never needed in build context.
node_modules/
dist/
.git/
.gitignore
.serena/
go-build/
db_data/
tmp/

# Why: Local Go binaries built by Makefile (build-backend / build-mc-util) — must not leak into image.
message-consolidator
mc-util
message-consolidator.service

# Why: Env files with secrets. Vite vars must be passed via --build-arg, not COPY.
.env*

# Why: Allow release notes inside container (backend serves them at runtime).
!RELEASE_NOTES_*.md
README.md
TODO.md
planning/

# Why: Logs, local DBs, test outputs — runtime/dev artifacts, not build inputs.
**/*.log
**/*.db
test_*.txt
ai/testdata/prompt_cache/*.txt

# Why: VPS-only scripts run on the host, not inside containers.
scripts/vps/

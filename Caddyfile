34.67.133.18.nip.io {
    root * /usr/share/caddy

    # [핵심] API 및 인증 경로 매처 (원본 경로 보존을 위해 handle_path 대신 handle 사용)
    @backend_routes {
        path /api/* /auth/* /health
    }

    handle @backend_routes {
        reverse_proxy backend:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 프론트엔드 SPA 라우팅 및 정적 파일 서버 격리
    handle {
        # Why: index.html had no Cache-Control, so browsers kept serving a stale shell that
        # pointed at an old bundle after a deploy. Hashed assets are safe to cache forever.
        @hashed_assets path /assets/*
        header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
        @app_shell not path /assets/*
        header @app_shell Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

